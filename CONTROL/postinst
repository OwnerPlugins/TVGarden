#!/bin/sh
# postinst script for TV Garden Plugin
# This script runs AFTER package files are unpacked

echo "=== TV Garden Plugin Post-Installation ==="

TVGARDEN_DIR="/usr/lib/enigma2/python/Plugins/Extensions/TVGarden"
LOCALE_DIR="/usr/lib/enigma2/python/Plugins/Extensions/TVGarden/locale"
ICONS_DIR="/usr/lib/enigma2/python/Plugins/Extensions/TVGarden/icons"
CACHE_DIR="/tmp/tvgarden_cache"

# 1. Imposta permessi corretti (dirs 755, files 644)
echo "Setting correct permissions..."
find "$TVGARDEN_DIR" -type d -exec chmod 755 {} \;
find "$TVGARDEN_DIR" -type f -exec chmod 644 {} \;
chown -R root:root "$TVGARDEN_DIR"

# Developer tools are not needed on the receiver
rm -f "$TVGARDEN_DIR/update_translations.py" "$TVGARDEN_DIR/translate_utils.py"

# Compile missing translations (gettext domain is "TVGarden")
if [ -d "$LOCALE_DIR" ] && command -v msgfmt >/dev/null 2>&1; then
    echo "Compiling language files..."
    for po in "$LOCALE_DIR"/*/LC_MESSAGES/TVGarden.po; do
        [ -f "$po" ] || continue
        mo="${po%.po}.mo"
        [ -f "$mo" ] || msgfmt -o "$mo" "$po" 2>/dev/null || true
    done
fi

echo "Creating cache directories..."
mkdir -p "$CACHE_DIR"
mkdir -p "/etc/enigma2/tvgarden/favorites"
chmod 777 "$CACHE_DIR"

# Skins are loaded directly from the plugin folder: no symlinks needed.
# Remove links created by older versions.
for skin_link in /usr/share/enigma2/TVGarden_*; do
    [ -L "$skin_link" ] && rm -f "$skin_link"
done

BACKUP_PATTERN="/tmp/tvgarden_backup_*"
LATEST_BACKUP=$(ls -td $BACKUP_PATTERN 2>/dev/null | head -1)
if [ -n "$LATEST_BACKUP" ] && [ -d "$LATEST_BACKUP" ]; then
    echo "Restoring configuration from backup..."
    cp -r "$LATEST_BACKUP"/* "/etc/enigma2/tvgarden/" 2>/dev/null || true
    rm -rf "$LATEST_BACKUP"
fi

find "/tmp" -name "tvgarden_*" -type f -mtime +7 -delete 2>/dev/null || true

echo ""
echo "TV Garden Plugin installed successfully!"
echo "Access it from: Main Menu -> Plugins -> TV Garden"
echo "Configuration: /etc/enigma2/tvgarden/config.json"
echo ""
echo "To complete installation, restart Enigma2 GUI:"
echo "  - reboot your receiver"
echo ""

if [ -f /usr/bin/enigma2.sh ]; then
    echo "NOTE: Some features may require a GUI restart."
fi

exit 0
